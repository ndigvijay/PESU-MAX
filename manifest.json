{
  "manifest_version": 3,
  "name": "PESU-MAX",
  "version": "3.0.5",
  "action": {
    "default_popup": "src/popup/index.html"
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "permissions": ["cookies", "storage", "downloads", "alarms"],
  "host_permissions": [
    "https://www.pesuacademy.com/*",
    "https://files.pesuacademy.com/*",
    "https://staff.pes.edu/*",
    "http://14.143.33.149/*",
    "https://www.ilovepdf.com/*",
    "https://*.ilovepdf.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.pesuacademy.com/*"],
      "js": ["content/startPage.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.pesuacademy.com/*"],
      "js": ["content/backNavigation.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.pesuacademy.com/*"],
      "css": ["content/hideTopBar.css"],
      "js": ["content/hideTopBarStart.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.pesuacademy.com/*"],
      "css": ["content/sideMenuState.css"],
      "js": ["content/sideMenuStateStart.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.pesuacademy.com/*"],
      "js": ["content/content.js"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/Pes_logo_square_ui.png", "content/startPageMain.js", "content/backNavigationMain.js"],
      "matches": ["https://www.pesuacademy.com/*"]
    }
  ]
}
